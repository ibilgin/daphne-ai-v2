    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Pipeline P99 Latency by Stage",
      "description": "99th-percentile latency per pipeline stage over 5m window.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "barRadius": 0,
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "stacking": "none",
        "fillOpacity": 80,
        "gradientMode": "none",
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "colorByField": "stage"
