# Copy to .env and adjust values before running docker compose.
# Never commit .env — it is in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=mlflow

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Application secrets ───────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-replace-in-production
WEBHOOK_SECRET=dev-webhook-secret-replace-in-production
ENABLE_TOKEN_CREATION=true

# ── Frontend proxy (server-side only — NOT embedded in client bundle) ─────────
# Override when running frontend outside Docker (points Vite proxy at the BFF).
# In Docker this is set automatically via docker-compose.yml.
# API_PROXY_TARGET=http://localhost:3001

# ── Ollama (must run on host: ollama serve) ───────────────────────────────────
OLLAMA_MODEL=mistral
