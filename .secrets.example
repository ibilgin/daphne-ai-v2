# Copy this file to .secrets and fill in real values.
# NEVER commit .secrets — it is in .gitignore.
#
# Usage with act:
#   act -j model-ci --secret-file .secrets
#   act -j rollback  --secret-file .secrets

# MinIO / S3 credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT_URL=http://localhost:9000

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5001

# Ollama (optional — defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Slack webhook for rollback notifications (optional)
SLACK_WEBHOOK_URL=

# GitHub token (needed for some act jobs)
GITHUB_TOKEN=
